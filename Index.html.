  function getTodayStr() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  }

  function getYesterdayStr() {
    const d = new Date();
    d.setDate(d.getDate() - 1);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  }

  let state = JSON.parse(localStorage.getItem("dailyEnglishCoachState_v5")) || {
    currentLevel: "A1",
    currentTopicId: "a1_1a",
    cardIndex: 0,
    completedTopics: [],
    xp: 0,
    streak: 0,
    lastPracticeDate: null,
    theoryVisible: true
  };

  function saveState() {
    localStorage.setItem("dailyEnglishCoachState_v5", JSON.stringify(state));
  }

  function registerDailyActivity(points) {
    state.xp += points;
    const today = getTodayStr();
    const yesterday = getYesterdayStr();

    if (state.lastPracticeDate === today) {
      // Mismo día
    } else if (state.lastPracticeDate === yesterday) {
      state.streak += 1;
      state.lastPracticeDate = today;
    } else {
      state.streak = 1;
      state.lastPracticeDate = today;
    }
    saveState();
    renderStats();
  }

  function renderStats() {
    document.getElementById("xp-pill").textContent = `⭐ ${state.xp} XP`;
    const streakText = state.streak === 1 ? "1 día" : `${state.streak} días`;
    document.getElementById("streak-banner").textContent = `🔥 Racha: ${streakText}`;
  }

  function applyTheoryVisibility() {
    const grid = document.getElementById("columns-grid");
    if (state.theoryVisible) {
      grid.classList.remove("theory-hidden");
    } else {
      grid.classList.add("theory-hidden");
    }
  }

  function toggleTheoryPanel() {
    state.theoryVisible = !state.theoryVisible;
    saveState();
    applyTheoryVisibility();
  }

  function findTopicById(id) {
    for (const lvl of ["A1", "A2", "DAILY", "QA"]) {
      for (const unitObj of database[lvl]) {
        const found = unitObj.topics.find(t => t.id === id);
        if (found) return { level: lvl, unit: unitObj.unit, topic: found };
      }
    }
    return null;
  }

  function switchLevel(lvl) {
    state.currentLevel = lvl;
    const firstTopic = database[lvl][0].topics[0];
    state.currentTopicId = firstTopic.id;
    state.cardIndex = 0;
    saveState();
    resetFeedback();
    renderAll();
  }

  function selectTopic(topicId) {
    state.currentTopicId = topicId;
    state.cardIndex = 0;
    saveState();
    resetFeedback();
    renderAll();
  }

  function renderSidebar() {
    ["A1", "A2", "DAILY", "QA"].forEach(lvl => {
      const el = document.getElementById(`tab-${lvl}`);
      if (el) el.className = `level-tab ${state.currentLevel === lvl ? "active" : ""}`;
    });

    const container = document.getElementById("topics-list");
    container.innerHTML = "";

    database[state.currentLevel].forEach(unitObj => {
      const group = document.createElement("div");
      group.className = "unit-group";

      const uTitle = document.createElement("div");
      uTitle.className = "unit-title";
      uTitle.textContent = unitObj.unit;
      group.appendChild(uTitle);

      unitObj.topics.forEach(topic => {
        const isCompleted = state.completedTopics.includes(topic.id);
        const isActive = state.currentTopicId === topic.id;

        const btn = document.createElement("button");
        btn.className = `topic-btn ${isActive ? "active" : ""} ${isCompleted ? "completed" : ""}`;
        btn.innerHTML = `
          <span>${topic.title}</span>
          <span class="topic-status">${isCompleted ? "✅" : `${topic.items.length}`}</span>
        `;
        btn.onclick = () => selectTopic(topic.id);
        group.appendChild(btn);
      });

      container.appendChild(group);
    });
  }

  function renderCard() {
    const data = findTopicById(state.currentTopicId);
    if (!data) return;

    const { level, unit, topic } = data;
    const item = topic.items[state.cardIndex];

    const levelMap = {
      A1: "A1",
      A2: "A2",
      DAILY: "Diario & Historias",
      QA: "Q&A Rápido"
    };

    document.getElementById("topic-badge").textContent = `${levelMap[level]} • ${unit}`;
    document.getElementById("topic-title").textContent = topic.title;
    document.getElementById("card-step").textContent = `Tarjeta ${state.cardIndex + 1} de ${topic.items.length}`;
    document.getElementById("progress-fill").style.width = `${(state.cardIndex / topic.items.length) * 100}%`;

    const qBox = document.getElementById("question-box");
    const listenBtn = document.getElementById("listen-btn");
    const micBtn = document.getElementById("mic-btn");

    if (item.question) {
      qBox.style.display = "block";
      document.getElementById("question-text").textContent = item.question;
      listenBtn.textContent = "🔊 Modelo";
      micBtn.textContent = "🎤 Responder";
    } else {
      qBox.style.display = "none";
      listenBtn.textContent = "🔊 Normal";
      micBtn.textContent = "🎤 Hablar";
    }

    document.getElementById("prompt-text").textContent = item.text;
    document.getElementById("phonetic-ipa").textContent = item.ipa;
    document.getElementById("phonetic-es").textContent = `🗣️ ${item.es}`;
    document.getElementById("meaning-text").textContent = item.meaning;
    document.getElementById("tip-box").textContent = `💡 ${item.tip}`;

    // Panel derecho de teoría
    document.getElementById("rule-pill").textContent = `Regla: ${topic.rule}`;
    document.getElementById("theory-body").textContent = topic.theory;
    document.getElementById("structure-formula").textContent = topic.formula;
    document.getElementById("mini-note").innerHTML = `<strong>¿Por qué se escribe así?</strong> ${topic.why}`;
  }

  function renderAll() {
    applyTheoryVisibility();
    renderStats();
    renderSidebar();
    renderCard();
  }

  function resetFeedback() {
    const data = findTopicById(state.currentTopicId);
    const isQA = data && data.topic.items[state.cardIndex] && data.topic.items[state.cardIndex].question;
    const fb = document.getElementById("feedback");
    fb.className = "feedback";
    if (isQA) {
      fb.innerHTML = `Lee la pregunta, presiona <strong>"Responder"</strong> y di la respuesta modelo (o una válida).`;
    } else {
      fb.innerHTML = `Presiona <strong>"Hablar"</strong> y pronuncia la frase en inglés. No avanzarás hasta decirla correctamente.`;
    }
  }

  function speakText(rate) {
    const data = findTopicById(state.currentTopicId);
    const item = data.topic.items[state.cardIndex];
    const utterance = new SpeechSynthesisUtterance(item.text);
    utterance.lang = "en-US";
    utterance.rate = rate;
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(utterance);
  }

  document.getElementById("listen-btn").onclick = () => speakText(0.95);
  document.getElementById("slow-btn").onclick = () => speakText(0.65);

  function normalize(str) {
    return str
      .toLowerCase()
      .replace(/i'm/g, "i am")
      .replace(/i'll/g, "i will")
      .replace(/let's/g, "let us")
      .replace(/you're/g, "you are")
      .replace(/he's/g, "he is")
      .replace(/she's/g, "she is")
      .replace(/it's/g, "it is")
      .replace(/we're/g, "we are")
      .replace(/they're/g, "they are")
      .replace(/isn't/g, "is not")
      .replace(/aren't/g, "are not")
      .replace(/wasn't/g, "was not")
      .replace(/weren't/g, "were not")
      .replace(/don't/g, "do not")
      .replace(/doesn't/g, "does not")
      .replace(/didn't/g, "did not")
      .replace(/can't/g, "cannot")
      .replace(/haven't/g, "have not")
      .replace(/hasn't/g, "has not")
      .replace(/i've/g, "i have")
      .replace(/we've/g, "we have")
      .replace(/i'd/g, "i would")
      .replace(/that's/g, "that is")
      .replace(/what's/g, "what is")
      .replace(/where's/g, "where is")
      .replace(/there's/g, "there is")
      .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?¿¡!']/g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  const micBtn = document.getElementById("mic-btn");
  const sessionBtn = document.getElementById("mic-session-btn");
  const feedback = document.getElementById("feedback");

  let recognition = null;
  let isListening = false;

  function initRecognition() {
    if (!SpeechRecognition || recognition) return;
    recognition = new SpeechRecognition();
    recognition.lang = "en-US";
    recognition.interimResults = false;
    recognition.maxAlternatives = 4;

    recognition.onstart = () => {
      isListening = true;
      sessionBtn.classList.add("ready");
      sessionBtn.textContent = "✅ Micrófono habilitado";
      micBtn.classList.add("recording");
      micBtn.textContent = "🎙️ Escuchando...";
      feedback.className = "feedback";
      feedback.textContent = "Te escucho... habla con claridad.";
    };

    recognition.onresult = (event) => {
      const results = Array.from(event.results[0]).map(r => normalize(r.transcript));
      const spokenMain = event.results[0][0].transcript;

      const data = findTopicById(state.currentTopicId);
      const topic = data.topic;
      const currentItem = topic.items[state.cardIndex];

      const validTargets = [normalize(currentItem.text), ...currentItem.alt.map(normalize)];
      const isMatch = results.some(res => validTargets.includes(res));

      if (isMatch) {
        registerDailyActivity(10);
        feedback.className = "feedback success";
        feedback.innerHTML = `✅ <strong>¡Muy bien! (+10 XP)</strong> Escuché: "${spokenMain}"`;

        setTimeout(() => {
          if (state.cardIndex + 1 < topic.items.length) {
            state.cardIndex++;
            resetFeedback();
          } else {
            registerDailyActivity(25);
            document.getElementById("progress-fill").style.width = "100%";
            if (!state.completedTopics.includes(topic.id)) {
              state.completedTopics.push(topic.id);
            }
            state.cardIndex = 0;
            feedback.className = "feedback success";
            feedback.innerHTML = `🎉 <strong>¡Tema completado! (+25 XP extra)</strong> Elige otro tema en el menú o vuelve a practicar.`;
          }
          saveState();
          renderAll();
        }, 1150);
      } else {
        feedback.className = "feedback error";
        feedback.innerHTML = `❌ Escuché: "<strong>${spokenMain}</strong>". Sigue bloqueado en esta tarjeta, inténtalo de nuevo.`;
      }
    };

    recognition.onerror = (event) => {
      isListening = false;
      micBtn.classList.remove("recording");
      const data = findTopicById(state.currentTopicId);
      const isQA = data && data.topic.items[state.cardIndex] && data.topic.items[state.cardIndex].question;
      micBtn.textContent = isQA ? "🎤 Responder" : "🎤 Hablar";

      if (event.error === "not-allowed" || event.error === "service-not-allowed") {
        sessionBtn.classList.remove("ready");
        sessionBtn.textContent = "🎙️ Habilitar Micrófono (1 sola vez)";
        feedback.className = "feedback error";
        feedback.textContent = "Permiso de micrófono bloqueado. Haz clic en el ícono de la barra de Chrome y selecciona Permitir.";
      } else if (event.error === "no-speech") {
        feedback.className = "feedback error";
        feedback.textContent = "No detecté voz. Presiona el botón y habla un poco más cerca del micrófono.";
      } else {
        feedback.className = "feedback error";
        feedback.textContent = `Aviso de audio (${event.error}). Intenta presionar nuevamente.`;
      }
    };

    recognition.onend = () => {
      isListening = false;
      micBtn.classList.remove("recording");
      const data = findTopicById(state.currentTopicId);
      const isQA = data && data.topic.items[state.cardIndex] && data.topic.items[state.cardIndex].question;
      micBtn.textContent = isQA ? "🎤 Responder" : "🎤 Hablar";
    };
  }

  async function requestPersistentMic() {
    if (!SpeechRecognition) return;
    initRecognition();

    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        stream.getTracks().forEach(track => track.stop());
        sessionBtn.classList.add("ready");
        sessionBtn.textContent = "✅ Micrófono habilitado";
        feedback.className = "feedback success";
        feedback.innerHTML = `✅ <strong>Micrófono listo.</strong> Ya quedó habilitado; ahora solo presiona el botón de voz en cada tarjeta.`;
      } catch (err) {
        feedback.className = "feedback error";
        feedback.textContent = "No se pudo habilitar el micrófono. Revisa los permisos de Chrome para este archivo.";
      }
    }
  }

  if (!SpeechRecognition) {
    feedback.className = "feedback error";
    feedback.textContent = "Tu navegador no soporta reconocimiento de voz. Ábrelo en Google Chrome.";
    micBtn.disabled = true;
    sessionBtn.disabled = true;
  } else {
    initRecognition();
    micBtn.onclick = () => {
      if (!recognition) initRecognition();
      if (isListening) {
        recognition.stop();
        return;
      }
      try {
        recognition.start();
      } catch (e) {
        recognition.stop();
        setTimeout(() => recognition.start(), 120);
      }
    };
  }

  document.getElementById("restart-topic-btn").onclick = () => {
    state.cardIndex = 0;
    saveState();
    renderCard();
    resetFeedback();
  };

  document.getElementById("reset-all-btn").onclick = () => {
    if (confirm("¿Seguro que quieres borrar todo tu progreso, racha y XP?")) {
      state = {
        currentLevel: "A1",
        currentTopicId: "a1_1a",
        cardIndex: 0,
        completedTopics: [],
        xp: 0,
        streak: 0,
        lastPracticeDate: null,
        theoryVisible: true
      };
      saveState();
      renderAll();
      resetFeedback();
    }
  };

  renderAll();
</script>
</body>
