              { text: "Can you drive a car", alt: [], ipa: "/kæn juː draɪv ə kɑːr/", es: "kan iu dráiv a kar", meaning: "¿Sabes conducir un auto?", tip: "'Can' expresa habilidad o posibilidad." },
