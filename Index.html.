            items: [
              { text: "I got up late and missed the bus", alt: [], ipa: "/aɪ ɡɒt ʌp leɪt ənd mɪst ðə bʌs/", es: "ái got ap léit and mist de bas", meaning: "Me levanté tarde y perdí el autobús", tip: "'Got up' es el pasado de 'get up'." },
              { text: "My computer broke yesterday", alt: [], ipa: "/maɪ kəmˈpjuːtər broʊk ˈjestərdeɪ/", es: "mái kom-piú-ter bróuk iés-ter-dei", meaning: "Mi computadora se rompió ayer", tip: "'Broke' es el pasado irregular de 'break' ('bróuk')." },
              { text: "We went to the mountains last month", alt: [], ipa: "/wiː went tə ðə ˈmaʊntɪnz lɑːst mʌnθ/", es: "uí uént tu de máun-tins last manz", meaning: "Fuimos a las montañas el mes pasado", tip: "'Went' es el pasado de 'go' ('uént')." },
