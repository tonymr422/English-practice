            items: [
              { text: "How was your weekend", alt: [], ipa: "/haʊ wɒz jɔːr ˌwiːkˈend/", es: "jáu uós ior uíik-end", meaning: "¿Cómo estuvo tu fin de semana?", tip: "Ideal para preguntar cómo le fue a alguien." },
              { text: "Was the meeting difficult", alt: [], ipa: "/wɒz ðə ˈmiːtɪŋ ˈdɪfɪkəlt/", es: "uós de míi-ting dí-fi-kalt", meaning: "¿Estuvo difícil la reunión?", tip: "'Difficult' lleva acento en 'DÍ'." },
              { text: "What time is the next train", alt: [], ipa: "/wɒt taɪm ɪz ðə nekst treɪn/", es: "uót táim is de nekst tréin", meaning: "¿A qué hora sale el próximo tren?", tip: "'Next' significa próximo o siguiente." },
