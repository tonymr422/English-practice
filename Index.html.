<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily English Coach — A1, A2, Diario & Q&A</title>
  <style>
    :root {
      --bg: #090e1a;
      --sidebar: #101727;
      --card: #172033;
      --card-inner: #0c1322;
      --theory-bg: #121b2e;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --accent: #38bdf8;
      --gold: #fbbf24;
      --purple: #c084fc;
      --success: #10b981;
      --error: #f87171;
      --border: #26334d;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }

    body {
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      min-height: 100vh;
    }

    /* Panel Izquierdo (Temario) */
    .sidebar {
      width: 315px;
      flex-shrink: 0;
      background-color: var(--sidebar);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: sticky;
      top: 0;
    }

    .sidebar-header {
      padding: 18px;
      border-bottom: 1px solid var(--border);
    }

    .brand-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .brand-title {
      font-size: 1.05rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .stats-pill {
      background-color: var(--card-inner);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.78rem;
      color: var(--gold);
      font-weight: 600;
    }

    .level-tabs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }

    .level-tab {
      padding: 7px 6px;
      border: 1px solid var(--border);
      background-color: var(--card-inner);
      color: var(--muted);
      border-radius: 9px;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .level-tab.active {
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      color: white;
      border-color: transparent;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }

    .topics-list {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
    }

    .topics-list::-webkit-scrollbar { width: 6px; }
    .topics-list::-webkit-scrollbar-thumb { background: #26334d; border-radius: 3px; }

    .unit-group { margin-bottom: 14px; }

    .unit-title {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      padding: 6px 10px;
      font-weight: 700;
    }

    .topic-btn {
      width: 100%;
      text-align: left;
      padding: 9px 12px;
      margin-bottom: 4px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 9px;
      color: #cbd5e1;
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      transition: all 0.15s;
    }

    .topic-btn:hover { background-color: rgba(38, 51, 77, 0.55); }

    .topic-btn.active {
      background-color: rgba(59, 130, 246, 0.18);
      border-color: rgba(59, 130, 246, 0.6);
      color: white;
      font-weight: 600;
    }

    .topic-status { font-size: 0.8rem; color: var(--muted); flex-shrink: 0; }
    .topic-btn.completed .topic-status { color: var(--success); }

    /* Contenedor Central + Derecho */
    .workspace {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 20px 24px;
      gap: 14px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .top-left-group {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    .mic-session-btn {
      background-color: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(16, 185, 129, 0.45);
      color: #6ee7b7;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .mic-session-btn.ready {
      background-color: rgba(16, 185, 129, 0.24);
      border-color: var(--success);
      color: #a7f3d0;
    }

    .toggle-theory-btn {
      background-color: rgba(192, 132, 252, 0.14);
      border: 1px solid rgba(192, 132, 252, 0.4);
      color: #e9d5ff;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .toggle-theory-btn:hover {
      background-color: rgba(192, 132, 252, 0.24);
    }

    .streak-banner {
      font-size: 0.84rem;
      color: var(--muted);
      background-color: var(--card);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 10px;
    }

    .columns-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.9fr);
      gap: 20px;
      align-items: start;
    }

    .columns-grid.theory-hidden {
      grid-template-columns: minmax(0, 1fr);
      max-width: 780px;
      width: 100%;
      margin: 0 auto;
    }

    .columns-grid.theory-hidden .theory-panel {
      display: none;
    }

    /* Tarjeta de Práctica */
    .practice-card {
      background-color: var(--card);
      border-radius: 18px;
      padding: 28px;
      box-shadow: 0 24px 40px -12px rgba(0, 0, 0, 0.6);
      border: 1px solid var(--border);
    }

    .topic-header { margin-bottom: 16px; }

    .topic-badge {
      display: inline-block;
      background-color: rgba(56, 189, 248, 0.14);
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 8px;
    }

    .topic-header h1 {
      font-size: 1.4rem;
      color: var(--text);
    }

    .progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.86rem;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background-color: var(--card-inner);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 22px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #10b981, #34d399);
      width: 0%;
      transition: width 0.35s ease;
    }

    .flashcard {
      background-color: var(--card-inner);
      border-radius: 14px;
      padding: 26px 22px;
      text-align: center;
      margin-bottom: 20px;
      border: 1px solid var(--border);
    }

    .question-box {
      background-color: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.35);
      border-radius: 10px;
      padding: 10px 14px;
      margin-bottom: 14px;
      font-size: 0.98rem;
      color: #bfdbfe;
    }

    .question-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      font-weight: 700;
      display: block;
      margin-bottom: 3px;
    }

    .prompt-text {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 10px;
      line-height: 1.25;
    }

    .phonetic-ipa {
      font-size: 1.02rem;
      color: var(--accent);
      font-family: monospace;
      margin-bottom: 6px;
    }

    .phonetic-es {
      font-size: 1.04rem;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 12px;
    }

    .meaning-text {
      font-size: 0.95rem;
      color: #e2e8f0;
      margin-bottom: 10px;
    }

    .tip-box {
      font-size: 0.84rem;
      color: var(--muted);
      background-color: rgba(30, 41, 59, 0.7);
      border-radius: 8px;
      padding: 8px 12px;
      display: inline-block;
    }

    .controls {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    button.action-btn {
      padding: 12px 16px;
      border: none;
      border-radius: 11px;
      font-size: 0.93rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 7px;
      transition: transform 0.1s, background-color 0.2s, opacity 0.2s;
    }

    button.action-btn:active { transform: scale(0.97); }
    button.action-btn:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-listen { background-color: #26334d; color: white; }
    .btn-listen:hover { background-color: #334566; }

    .btn-slow { background-color: #131c2e; color: #cbd5e1; border: 1px solid var(--border); }
    .btn-slow:hover { background-color: #1d2a44; }

    .btn-mic { background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; }
    .btn-mic:hover { background: linear-gradient(135deg, #1d4ed8, #2563eb); }
    .btn-mic.recording {
      background: linear-gradient(135deg, #dc2626, #ef4444);
      animation: pulse 1.2s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .feedback {
      min-height: 54px;
      text-align: center;
      padding: 12px;
      border-radius: 10px;
      font-size: 0.93rem;
      background-color: rgba(12, 19, 34, 0.75);
      border: 1px solid transparent;
    }

    .feedback.success { color: #6ee7b7; border-color: rgba(16, 185, 129, 0.4); }
    .feedback.error { color: #fca5a5; border-color: rgba(248, 113, 113, 0.4); }

    .footer-actions {
      display: flex;
      justify-content: space-between;
      margin-top: 16px;
      font-size: 0.82rem;
      color: var(--muted);
    }

    .text-link { cursor: pointer; text-decoration: underline; }
    .text-link:hover { color: var(--text); }

    /* Panel Derecho de Teoría */
    .theory-panel {
      background-color: var(--theory-bg);
      border-radius: 18px;
      padding: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.5);
    }

    .theory-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .theory-header h2 {
      font-size: 1.08rem;
      color: #f3e8ff;
    }

    .rule-pill {
      display: inline-block;
      background-color: rgba(192, 132, 252, 0.16);
      color: var(--purple);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 12px;
    }

    .theory-body {
      font-size: 0.92rem;
      line-height: 1.58;
      color: #cbd5e1;
      margin-bottom: 16px;
    }

    .structure-box {
      background-color: var(--card-inner);
      border: 1px solid #2a3b5c;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 14px;
    }

    .structure-label {
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 6px;
    }

    .structure-formula {
      font-family: monospace;
      font-size: 0.88rem;
      color: #f8fafc;
      line-height: 1.45;
    }

    .mini-note {
      font-size: 0.82rem;
      color: var(--muted);
      background-color: rgba(15, 23, 42, 0.65);
      border-left: 3px solid var(--gold);
      padding: 10px 12px;
      border-radius: 0 8px 8px 0;
      line-height: 1.45;
    }

    @media (max-width: 1120px) {
      .columns-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 860px) {
      body { flex-direction: column; }
      .sidebar { width: 100%; height: auto; max-height: 280px; position: relative; }
    }
  </style>
</head>
<body>

  <!-- PANEL IZQUIERDO: TEMARIO -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="brand-row">
        <div class="brand-title">🎯 Daily English Coach</div>
        <div class="stats-pill" id="xp-pill">⭐ 0 XP</div>
      </div>
      <div class="level-tabs">
        <button class="level-tab active" id="tab-A1" onclick="switchLevel('A1')">A1</button>
        <button class="level-tab" id="tab-A2" onclick="switchLevel('A2')">A2</button>
        <button class="level-tab" id="tab-DAILY" onclick="switchLevel('DAILY')">☀️ Diario</button>
        <button class="level-tab" id="tab-QA" onclick="switchLevel('QA')">⚡ Q&A</button>
      </div>
    </div>
    <div class="topics-list" id="topics-list"></div>
  </aside>

  <!-- CONTENEDOR PRINCIPAL -->
  <div class="workspace">
    <div class="top-bar">
      <div class="top-left-group">
        <button class="mic-session-btn" id="mic-session-btn" onclick="requestPersistentMic()">
          🎙️ Habilitar Micrófono (1 sola vez)
        </button>
        <button class="toggle-theory-btn" id="toggle-theory-btn" onclick="toggleTheoryPanel()">
          📘 Ocultar / Ver Teoría
        </button>
      </div>
      <div class="streak-banner" id="streak-banner">🔥 Racha: 0 días</div>
    </div>

    <div class="columns-grid" id="columns-grid">
      <!-- PANEL CENTRAL: PRÁCTICA -->
      <main class="practice-card">
        <div class="topic-header">
          <span class="topic-badge" id="topic-badge">A1 • Unidad 1</span>
          <h1 id="topic-title">1A. Saludos y países</h1>
        </div>

        <div class="progress-info">
          <span id="card-step">Tarjeta 1 de 6</span>
          <span id="lock-hint">🔒 Pronuncia bien para avanzar</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" id="progress-fill"></div>
        </div>

        <div class="flashcard">
          <div class="question-box" id="question-box" style="display:none;">
            <span class="question-label">❓ Pregunta</span>
            <div id="question-text"></div>
          </div>
          <div class="prompt-text" id="prompt-text">Hello, nice to meet you</div>
          <div class="phonetic-ipa" id="phonetic-ipa">/həˈloʊ naɪs tə miːt juː/</div>
          <div class="phonetic-es" id="phonetic-es">🗣️ jelóu, náis tu míit iu</div>
          <div class="meaning-text" id="meaning-text">Hola, mucho gusto en conocerte</div>
          <div class="tip-box" id="tip-box">💡 Tip: La "h" en "hello" suena suave como una "j" aspirada.</div>
        </div>

        <div class="controls">
          <button class="action-btn btn-listen" id="listen-btn">🔊 Respuesta</button>
          <button class="action-btn btn-slow" id="slow-btn">🐢 Lento</button>
          <button class="action-btn btn-mic" id="mic-btn">🎤 Responder</button>
        </div>

        <div class="feedback" id="feedback">
          Habilita el micrófono una vez arriba y luego presiona <strong>"Responder"</strong> para hablar.
        </div>

        <div class="footer-actions">
          <span class="text-link" id="restart-topic-btn">Reiniciar este tema</span>
          <span class="text-link" id="reset-all-btn">Borrar todo el progreso</span>
        </div>
      </main>

      <!-- PANEL DERECHO: TEORÍA Y POR QUÉ SE ESCRIBE ASÍ -->
      <aside class="theory-panel" id="theory-panel">
        <div class="theory-header">
          <span>📘</span>
          <h2>Guía Gramatical y Reglas</h2>
        </div>
        <div class="rule-pill" id="rule-pill">Regla: Verbo "be" y preguntas</div>
        <p class="theory-body" id="theory-body">
          En inglés, las preguntas con el verbo <strong>be</strong> invierten el orden respecto a una afirmación: primero va el verbo (<em>are</em>) y luego el sujeto (<em>you</em>).
        </p>
        <div class="structure-box">
          <div class="structure-label">Estructura base</div>
          <div class="structure-formula" id="structure-formula">[Wh-word] + be + sujeto + complemento</div>
        </div>
        <div class="mini-note" id="mini-note">
          <strong>¿Por qué se escribe así?</strong> A diferencia del español, el sujeto (<em>I, you, we</em>) casi nunca se omite y los gentilicios/países siempre van con mayúscula inicial.
        </div>
      </aside>
    </div>
  </div>

<script>
  const database = {
    A1: [
      {
        unit: "Unidad 1: Presentaciones y Trabajos",
        topics: [
          {
            id: "a1_1a",
            title: "1A. Saludos y países",
            rule: "Verbo 'be' (I / you) y mayúsculas",
            theory: "El verbo 'to be' en presente con 'you/we/they' usa 'are', y con 'I' usa 'am' (o su contracción 'I'm'). En inglés, los nombres de países y nacionalidades siempre comienzan con mayúscula.",
            formula: "Afirmativa: Sujeto + am/are + ... | Pregunta: (Wh-) + Are + you + from...?",
            why: "No se dice 'I from Argentina' porque falta el verbo 'am'. Decir 'I'm' une el pronombre con el verbo en habla cotidiana.",
            items: [
              { text: "Hello, nice to meet you", alt: [], ipa: "/həˈloʊ naɪs tə miːt juː/", es: "jelóu, náis tu míit iu", meaning: "Hola, mucho gusto en conocerte", tip: "En 'meet' la doble 'e' es larga ('míit')." },
              { text: "Where are you from", alt: [], ipa: "/wer ɑːr juː frɒm/", es: "uér ar iu from", meaning: "¿De dónde eres?", tip: "'Where' suena parecido a 'uér', sin arrastrar fuerte." },
              { text: "I'm from Argentina", alt: ["i am from argentina"], ipa: "/aɪm frɒm ˌɑːrdʒənˈtiːnə/", es: "áim from ar-yen-tíi-na", meaning: "Soy de Argentina", tip: "El acento principal en inglés va en 'ti': ar-yen-TÍI-na." },
              { text: "Are you here for the conference", alt: [], ipa: "/ɑːr juː hɪər fɔːr ðə ˈkɒnfərəns/", es: "ar iu jíar for de kón-fe-rens", meaning: "¿Estás aquí por la conferencia?", tip: "'Here' suena como 'jíar'." },
              { text: "You aren't late", alt: ["you are not late"], ipa: "/juː ɑːrnt leɪt/", es: "iu arnt léit", meaning: "No llegas tarde", tip: "'Late' termina con sonido seco de 't' ('léit')." },
              { text: "I'm not a teacher", alt: ["i am not a teacher"], ipa: "/aɪm nɒt ə ˈtiːtʃər/", es: "áim not a tíi-cher", meaning: "No soy profesor", tip: "'Teacher' lleva 'i' larga al inicio y 'er' suave al final." }
            ]
          },
          {
            id: "a1_1b",
            title: "1B. Trabajos y profesiones",
            rule: "Verbo 'be' (he/she/it) y artículos a/an",
            theory: "Con 'he', 'she' e 'it' usamos 'is' (o la contracción 's: he's, she's, it's). Al hablar de profesiones en singular, se coloca 'a' antes de sonido consonante y 'an' antes de sonido vocálico.",
            formula: "Sujeto (he/she/it) + is ('s) / isn't + a/an + profesión",
            why: "Usamos 'an office worker' (y no 'a office worker') porque 'office' empieza con sonido de vocal (/ɒ/).",
            items: [
              { text: "He's a football player", alt: ["he is a football player"], ipa: "/hiːz ə ˈfʊtbɔːl ˈpleɪər/", es: "jiis a fút-bol pléi-er", meaning: "Él es jugador de fútbol", tip: "'Football' suena más como 'fút-bol' con 'u' corta." },
              { text: "She's a doctor", alt: ["she is a doctor"], ipa: "/ʃiːz ə ˈdɒktər/", es: "shiis a dók-tor", meaning: "Ella es doctora", tip: "'She's' empieza con 'sh' suave ('shiis')." },
              { text: "I'm an office worker", alt: ["i am an office worker"], ipa: "/aɪm ən ˈɒfɪs ˈwɜːrkər/", es: "áim an ó-fis uér-ker", meaning: "Soy empleado de oficina", tip: "'Worker' empieza con sonido de 'u' ('uér-ker')." },
              { text: "Is he a taxi driver", alt: [], ipa: "/ɪz hiː ə ˈtæksi ˈdraɪvər/", es: "is ji a ták-si drái-ver", meaning: "¿Él es taxista?", tip: "'Driver' rima con 'drái-ver'." },
              { text: "She isn't a nurse", alt: ["she is not a nurse"], ipa: "/ʃiː ˈɪznt ə nɜːrs/", es: "shi í-sent a ners", meaning: "Ella no es enfermera", tip: "'Nurse' tiene vocal central 'er' ('ners')." },
              { text: "My brother is a pilot", alt: [], ipa: "/maɪ ˈbrʌðər ɪz ə ˈpaɪlət/", es: "mái brá-der is a pái-lot", meaning: "Mi hermano es piloto", tip: "'Pilot' suena como 'pái-lot'." }
            ]
          },
          {
            id: "a1_1c",
            title: "1C. Nacionalidades e información",
            rule: "Plural con 'they/we' y preguntas con 'how/what'",
            theory: "Para grupos o varias personas usamos 'we' o 'they' junto con 'are' ('re) o 'aren't'. Las preguntas de información comienzan con palabras interrogativas como 'What' o 'How'.",
